        <input class="Barra" type="ape" id="apellido" name="apellido" placeholder="Ingrese sus apellidos">

        <label for="telefono">Teléfono:</label>
        <input class="Barra" type="tel" id="telefono" name="telefono" placeholder="Ingrese su número de teléfono">

        <label for="contraseña">Contraseña:</label>
        <input class="Barra" type="contra" id="contraseña" name="contraseña" placeholder="Ingrese su nueva contraseña">
        <button type="button" onclick="guardarDatos()">Guardar</button>
    </form>
