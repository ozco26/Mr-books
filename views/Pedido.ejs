<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Gestión de Pedidos - Admin</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstiloPedido.css" />
    <script src="/FuncionesBotones/BotónBuscarPedido.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<header class="header">
  <div class="logo">
    <a href="/homeAdmnin/<%= usuario.ID %>" title="Home">
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/" title="Cerrar Sesion">
      <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
    </a>
  </nav>
</header>
<body>
  <div class="pedido">
        <br>
        <h1>Gestión de Pedidos - Admin</h1>
        <br>
        <div class="filters">
            <label for="filtroPedido">Buscar por Número de Pedido:</label>
            <input type="text" id="filtroPedido" name="filtroPedido" placeholder="Número de Pedido">
            <button id="btnBuscar" onclick="buscarPedido()">Buscar</button>
            <button id="btnVolver" onclick="Volver()">Volver</button>
        </div>

        <!--Función para el botón Buscar pedido-->
        <script>
          function buscarPedido() {
              var numeroPedido = document.getElementById('filtroPedido').value;
              var filas = document.querySelectorAll('.content tbody tr');
              filas.forEach(function(fila) {
                  fila.style.display = 'none';
              });
      
              if (!numeroPedido) {
                  filas.forEach(function(fila) {
                      fila.style.display = '';
                  });
                  return;
              }
              filas.forEach(function(fila) {
                  var numeroPedidoFila = fila.cells[0].textContent;
                  if (numeroPedidoFila === numeroPedido) {
                      fila.style.display = '';
                  }
              });
          }
       </script> 
<!--Función para el botón Volver en Pedido-->
    <script>
      function Volver() {
        var filas = document.querySelectorAll('.content tbody tr');
        filas.forEach(function(fila) {
            fila.style.display = '';
        });
        document.getElementById('filtroPedido').value = '';
    }
    </script>

  <div class="estados">
    <h2>Estado de Pedidos</h2>
    <br>
        <tr>
            <span>Todos (<%= pedidos.length %>)</span>
        </tr>
        <tr>
            <span> 1. Pendiente (<%= pedidos.filter(pedido => pedido.Estado === 1).length %>)</span>
        </tr>
        <tr>
          <span> 2. En Proceso (<%= pedidos.filter(pedido => pedido.Estado === 2).length %>)</span>
      </tr>
      <tr>
        <span>3. Enviado(<%= pedidos.filter(pedido => pedido.Estado === 3).length %>)</span>
      </tr>
      <tr>
        <span>4. Entregado (<%= pedidos.filter(pedido => pedido.Estado === 4).length %>)</span>
      </tr>
  </div>
  <div class="content">
        <table>
            <thead>
                <tr>
                    <th>Número de Pedido</th>
                    <th>Producto</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
              <tbody>
              <% pedidos.forEach((pedidos)=>{ %>
                <tr>
                    <td><%= pedidos.ID_Pedido %></td>
                    <td><%= pedidos.Producto %></td>
                    <td><%= pedidos.Cliente %></td>
                    <td><%= pedidos.Fecha %></td>
                    <td id= "nuevoEstado" contenteditable="true"><%= pedidos.Estado %></td>       
                    <td>
                      <a href="#" onclick="editar('<%= pedidos.ID_Pedido %>', '<%=usuario%>', obtenerNuevoEstado())">Actualizar</a>
                      <a href="#" onclick="borrar('<%= pedidos.ID_Pedido %>', '<%=usuario %>')" >Borrar</i></a>
                    </td>
              </tr>
                <% }) %>
            </tbody>     
        </table>  
    </div>

    <footer class="Pie">
      <div class="contenedor">
        <div class="pie-row">
          <div class="pie-links">
            <h4>Quienes somos</h4>
            <ul>
              <li><a href="#">Nosotros</a></li>
              <li><a href="#">Nuestros servicios</a></li>
              <li><a href="#">Politica de privacidad</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Cuenta</h4>
            <ul>
              <li><a href="#">Cuenta</a></li>
              <li><a href="#">Carrito</a></li>
              <li><a href="#">Compras</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Tienda</h4>
            <ul>

              <li><a href="/Novedades">Novedades</a></li>
              <li><a href="#">Categorias</a></li>
            </ul>
          </div>
          
        </div>
      </div>
    </footer>
</body>

<script>
  function goBack() {
      window.history.back();
  }

  function borrar(id,usuario) {
          Swal.fire({
              title: 'Está seguro?',
              text: "Eliminaras el registro permanentemente!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#3085d6',
              cancelButtonColor: '#d33',
              confirmButtonText: 'Si, eliminar!'
          }).then((result) => {
              if (result.isConfirmed) {
                  window.location = '/deletePedidos/' + id+'/'+usuario;
              }
          })
  }

  function editar(id, usuario, nuevoEstado) {
    Swal.fire({
        title: 'Está seguro?',
        text: "Editarás el registro permanentemente!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Si, Editar!'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location = `/actualizarPedido/${id}/${usuario}/${nuevoEstado}`;
        }       
    });
}
function obtenerNuevoEstado() {
    var nuevoEstado = document.getElementById('nuevoEstado').innerText;
    return nuevoEstado;
  }


</script>

</html>
