<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Mr. Books Gestión de Categorias</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<header class="header">
    <div class="logo">
        <a href="/homeAdmnin/<%=idUsuario %>" title="Home" >
            <img src="/Recursos/Logo.png" alt="Home" />
          </a>
    </div>
    <nav>
        <a class="MENUA" href="/" title="Cerrar Sesion">
            <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
          </a>
    </nav>
</header>
<body>
    <h1 style="text-align: center;">Gestión de Categorías - Admin</h1>
    </div>
    <h1 class="text-primary mt-2">Categorias</h1>
    <hr>
    <br>
    <div class="container" style="display: flex; align-items: flex-start;">
        <div class="row" style="width: 50%; padding: 20px; ">
            <form id="frmCategoria" action="/createCategoria" method="POST" >
                <div class="form-group">
                    <input class="Barra" type="text" name="txtCategoria" placeholder="Escriba la categoria nueva a agregar">
                    <input class="Barra" type="text" name="idUsuario" value="<%= idUsuario %>"  style="display: none;">
                </div>
                <br>
                <button id="btnGuadarCategoria">Guardar</button>

            </form>
        </div>
        <div class="row" style="width: 50%; padding: 20px; ">
            <table table id="crud"> <!--La tabla va alimentada de la base de datos-->
                <thead style="background-color: lightgray;">
                    <tr>
                        <th>ID de Categoria</th>
                        <th>Categoria</th>
                        
                    </tr>
                </thead>
                <tbody>
                    <% Categorias.forEach((generos)=>{ %>
                        <tr>
                            <td>
                                <%= generos.ID_Genero  %>
                            </td>
                            <td>
                                <%= generos.Genero %>
                            </td>

                            
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <br>
        </div>
    </div>
    </div>

    <footer class="Pie">
        <div class="contenedor">
            <div class="pie-row">
                <div class="pie-links">
                    <h4>Quienes somos</h4>
                    <ul>
                        <li><a href="/nosotros">Nosotros</a></li>
                        <li><a href="/nuestrosServicios">Nuestros servicios</a></li>
                        <li><a href="/politicaPrivacidad">Politica de privacidad</a></li>
                      </ul>
                </div>


            </div>
        </div>
    </footer>
</body>
<script>
var editStatus = false;
var idSElec = "";


    function borrar(id,idUsusario) {
        Swal.fire({
            title: 'Esta seguro?',
            text: "Eliminaras el registro permanentemente!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Si, eliminar!'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location = '/deleteCategoria/' + id+'/'+idUsusario;
    }
})
}
</script>
</html>