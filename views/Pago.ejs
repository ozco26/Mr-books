<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Página principal</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosPago.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  </head>
  <header class="header">
    <div class="logo">
      <a href="">
        <img src="/Recursos/Logo.png" alt="Logo" />
      </a>
    </div>
    <nav>
      <a class="MENUA" href="Home.html">
        <img src="/Recursos/Home.png" alt="Home" />
      </a>
      <a class="MENUA" href="#">
        <img src="/Recursos/User.png" alt="" />
      </a>
    </nav>
  </header>

  <body>
    <form id="forms">
      <p class="pagos">
        <img src="/Recursos/Metodos de pago.png" alt="Metodos de pago" />
      </p>

      <input type="hidden" name ="ID_Carrito" value="<%= ID_Carrito %>">
      <label for="nombre-titular">Nombre del Titular:</label>
      <input type="text" id="nombre-titular" name="nombre-titular" required />

      <label for="num-tarjeta">Número de Tarjeta:</label>
      <input
        type="text"
        id="num-tarjeta"
        name="num-tarjeta"
        placeholder="XXXX XXXX XXXX XXXX"
        required
      />

      <div>
        <label for="fecha-exp">Caducidad:</label>
        <input
          type="text"
          id="fecha-exp"
          name="fecha-exp"
          placeholder="MM/AA"
          required
        />

        <label for="cvv">CVV:</label>
        <input type="text" id="cvv" name="cvv" required />
      </div>

      
      <label for="email">Correo Electrónico:</label>
      <input type="text" id="email" name="email" placeholder="A esta dirección se enviará la factura" required />

      <DIV>
        <div>
          <table>
            <tr>
              <td>
                <label for="Dirección">Dirección:</label>
              </td>
            </tr>
            <tr>
              <td>
                <textarea
                  class="Texto"
                  name="Descripción"
                  id="Descripción"
                  cols="30"
                  rows="10"
                  placeholder="Se le contactará para calcular el precio de envío..."
                ></textarea>
              </td>
            </tr>
          </table>
      </div>
</DIV>
    

    <button type="submit">Pagar</button>
</form>
    

      
      <footer class="Pie">
        <div class="contenedor">
          <div class="pie-row">
            <div class="pie-links">
              <h4>Quienes somos</h4>
              <ul>
                <li><a href="#">Nosotros</a></li>
                <li><a href="#">Nuestros servicios</a></li>
                <li><a href="#">Politica de privacidad</a></li>
              </ul>
            </div>
            <div class="pie-links">
              <h4>Cuenta</h4>
              <ul>
                <li><a href="#">Cuenta</a></li>
                <li><a href="#">Carrito</a></li>
                <li><a href="#">Compras</a></li>
              </ul>
            </div>
            <div class="pie-links">
              <h4>Tienda</h4>
              <ul>
                <li><a href="#">Inicio</a></li>
                <li><a href="/Novedades/<%=idUsuario %>">Novedades</a></li>
                <li><a href="#">Categorias</a></li>
              </ul>
            </div>
            
          </div>
        </div>
      </footer>
      

    var nf = document.getElementById('nf');
    var valorfactura = factura();
    var valorfecha = fecha();
    nf.value = valorfactura;
    var fe = document.getElementById('fe');
    fe.value = valorfecha;


    function factura(){
      numeroFactura = Math.floor(Math.random() * 1000) + 1;
      return numeroFactura;
    }

    function fecha(){
      fechaEmision = new Date().toLocaleDateString();
      return fechaEmision;
    }

        function Aprobar (usuario,ID_Carrito){
        console.log("ID:", ID_Carrito);
        console.log("ID Usuario:", usuario);
        window.location.href = '/EstadoVendido/' + usuario +"/"+ ID_Carrito;
        }

        function sendMail(event){
          Swal.fire({
        title: "Su compra ha sido realizada!",
        text: "Gracias por tu Compra, en unos momentos se enviará su factura electrónica!",
        icon: "success",
      })
          event.preventDefault();
        (function(){
          emailjs.init("f1kSJjA9RxtaWYFE8"); // Account Public Key
        })();

        var params = {
          nombretitular: document.querySelector("#nombre-titular").value,
          email: document.querySelector("#email").value,
          numeroFactura: document.querySelector("#nf").value,
        fechaEmision: document.querySelector("#fe").value,
        direccion: document.querySelector("#Descripción").value,
        };

        var serviceID = "service_ime895m"; // Email Service ID
        var templateID = "template_tbi0qzb"; // Email Template ID

        emailjs.send(serviceID, templateID, params)
        .then( res => {
        })
        .catch();
      }
  </script>
    </body>
</html>

