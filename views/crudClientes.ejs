<body>
    <h1 style="text-align: center;">Gestión de Usuarios - Admin</h1>
    <br>
<div style="display: flex;   justify-content: center; align-items: center;">
    <table > <!--La tabla va alimentada de la base de datos-->
        <thead style="background-color: lightgray;">
            <tr>
                <th>ID </th>
                <th>Cedula</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Telefono</th>
                <th>Correo</th>
                <th>Contraseña</th>
                <th>Fecha Nacimiento</th>
                <th>Rol</th>
                
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% results.forEach((USUARIOS)=>{ %>
                <tr>
                    <td><%= USUARIOS.ID %></td>
                    <td><%= USUARIOS.Cedula %></td>
                    <td><%= USUARIOS.Nombre %></td>
                    <td><%= USUARIOS.Apellidos %></td>
                    <td><%= USUARIOS.Telefono%></td>
                    <td><%= USUARIOS.Correo%></td>
                    <td><%= USUARIOS.Contrasenna %></td>
                    <td><%= USUARIOS.Fecha_nacimiento instanceof Date ? USUARIOS.Fecha_nacimiento.toISOString().substring(0, 10) : '' %></td>
                    <td><%= USUARIOS.Rol  %></td>
                    
                    <td>
                        <a href="#" onclick="editar('<%= USUARIOS.ID %>', '<%=id %>')" >Editar</i></a>
                        <a href="#" onclick="borrar('<%= USUARIOS.ID %>', '<%=id %>')" >Borrar</i></a>

                    </td>
                </tr>

            <% }) %>
        </tbody>
    </table>
</div>
