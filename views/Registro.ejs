<script>
  document.getElementById('formUserCreate').addEventListener('submit', function (event) {
    event.preventDefault();
    var pendiente;

    if (validarForm()) {
      if(validarPass()){
        this.submit();
      }else{
        Swal.fire
        ({
          icon: 'error',
          title: 'Oops...  ',
          text: 'Por favor, verifique que la contraseña coinsida',
        })
      }
    } else {
      // Utiliza SweetAlert en lugar de alert
      Swal.fire({
        icon: 'error',
        title: 'Oops...  ',
        text: 'Por favor, complete todos los campos del formulario.',
      });
    }
  });

  function validarForm() {
    var cedula = document.getElementById('cedula').value;
    var nombre = document.getElementById('nombre').value;
    var apellidos = document.getElementById('apellidos').value;
    var telefono = document.getElementById('telefono').value;
    var correo = document.getElementById('email').value;
    var fechaNacimiento = document.getElementById('nacimiento').value;
    var contrasena = document.getElementById('password').value;
    var confirm_password = document.getElementById('confirm_password').value;

    if (cedula === '' || nombre === '' || apellidos === '' || fechaNacimiento === '' || correo === '' || contrasena === '' || telefono==='' || confirm_password==='') {
      return false;
    } else {
    return true;}
  }

  function validarPass(){
    var contrasena = document.getElementById('password').value;
    var confirm_password = document.getElementById('confirm_password').value;
    if (contrasena !== confirm_password){
      return false;
    }else{
      return true;
    }
  }


  </script>

