<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Mr. Books Gestión de Libros</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<header class="header">
    <div class="logo">
        <a href="/homeAdmnin/<%=idUsuario %>"title="Home">
            <img src="/Recursos/Logo.png" alt="Home" />
      </a>
    </div>
    <nav>

        <a class="MENUA" href="/" title="Cerrar Sesion">
            <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
        </a>
    </nav>
  </header>


<body>
    <h1 style="text-align: center;">Gestión de Libros - Admin</h1>
    <br>
<div style="display: flex;   justify-content: center; align-items: center;" >
    <table id="crud"> <!--La tabla va alimentada de la base de datos-->
        <thead style="background-color: lightgray;">
            <tr>
                <th>ID </th>
                <th>Nombre</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Anno</th>
                <th>Genero</th>
                <th>Precio</th>
                <th>Estado</th>
                
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.forEach((PRODUCTOS)=>{ %>
                <tr>
                    <td><%= PRODUCTOS.ID_Producto  %></td>
                    <td><%= PRODUCTOS.Nombre %></td>
                    <td><%= PRODUCTOS.Autor  %></td>
                    <td><%= PRODUCTOS.Editorial %></td>
                    <td><%= PRODUCTOS.Anno %></td>
                    <td><%= PRODUCTOS.Genero  %></td>
                    <td><%= PRODUCTOS.Precio %></td>
                    <td><%= PRODUCTOS.Estado   %></td>
                    
                    <td>
                        
                        <a href="#" onclick="borrar('<%= PRODUCTOS.ID_Producto  %>', '<%=idUsuario %>')" >Borrar</i></a>

                    </td>
                </tr>

            <% }) %>
        </tbody>
    </table>
</div>
    <br>


    <footer class="Pie">
        <div class="contenedor">
            <div class="pie-row">
                <div class="pie-links">
                    <h4>Quienes somos</h4>
                    <ul>
                        <li><a href="/nosotros">Nosotros</a></li>
                        <li><a href="/nuestrosServicios">Nuestros servicios</a></li>
                        <li><a href="/politicaPrivacidad">Politica de privacidad</a></li>
                      </ul>
                </div>
            </div>
        </div>
    </footer>
</body>

<script>
    function goBack() {
        window.history.back();
    }

    function borrar(id,idUsusario) {
            Swal.fire({
                title: 'Esta seguro?',
                text: "Eliminaras el registro permanentemente!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si, eliminar!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location = '/deleteProducto/' + id+'/'+idUsusario;
                }
            })
        }
    
    
     
    

</script>

</html>