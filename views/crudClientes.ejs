</body>

<script>
    function goBack() {
        window.history.back();
    }

    function borrar(id,idUsusario) {
            Swal.fire({
                title: 'Esta seguro?',
                text: "Eliminaras el registro permanentemente!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si, eliminar!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location = '/delete/' + id+'/'+idUsusario;
                }
            })
        }
    function editar (id,idUsusario){
        console.log("ID:", id);
        console.log("ID Usuario:", idUsusario);
        window.location = '/editar/' + id + '/' + idUsusario;
                }

    
     
     function obtenerIdDeUsuario(){
