<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Mis libros</title>
  <link rel="stylesheet" href="/Estilos/Estilos.Css" />
  <link rel="stylesheet" href="Estilos/EstilosCRUDP.css">
  <script src="Javascript/CrearArticulo.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<header class="header">
  <div class="logo">
    <a href="/homeVendedor/<%= usuario.ID  %>" title="Home">
      <img src="/Recursos/Logo.png" alt="Home" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/homeVendedor/<%= usuario.ID  %>" title="Home">
      <img src="/Recursos/Home.png" alt="Home">
    </a>
    <a class="MENUA" href="/editarUsuario/<%=usuario.ID%>" title="Cuenta de Usuario">
      <img src="/Recursos/User.png" alt="Cuenta">
    </a>
    <a class="MENUA" href="/carrito/<%=usuario.ID%>" title="Carrito de Compras">
      <img src="/Recursos/Carrito.png" alt="Carrito de Compras">
    </a>
  </nav>
</header>

<style>
  .Barra{
    display: flex;
    padding: 10px 20px;
    width: 300px;
    height: 38px;
    background-color: #E1C2A1;
    border-radius: 30px;
    align-items: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
}

.Barra input{
    outline: none;
    border: none;
    font-weight: 500;
}
#imagenLibro {
    width: 495px;
    height: 754px;
}

/*TextArea*/
.Texto {
    display: flex;
    padding: 10px 20px;
    width: 500px;
    background-color: #E1C2A1;
    border-radius: 30px;
    align-items: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
}

.Texto textarea {
    outline: none;
    border: none;
    font-weight: 500;
    width: 100%; /* El textarea ocupará todo el ancho disponible */
    height: 100px; /* Altura deseada del textarea */
    margin: 0 auto; /* Centrar el textarea */
    resize: none; /* Evitar que el usuario redimensione el textarea */
}

/*Selector*/
.Selector {
    display: flex;
    padding: 10px 20px;
    width: 300px;
    height: 38px;
    background-color: #E1C2A1;
    border-radius: 30px;
    align-items: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
}

.Selector select {
    outline: none;
    border: none;
    font-weight: 300;
    width: 100%; 
    height: 100%; 
    background: transparent; 
    cursor: pointer; 
}

/*Tabla*/
button {
    background-color: #8a5929;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.estados span{
    border: 2px;
    padding: 8px;
    text-align: center;
    font-weight: bold;
}

.estado-pendiente, .estado-en-proceso, .estado-completo {
    width: 88px;
    height: 28px;
    text-align:center;
    line-height: 50px;
    border-radius: 5px;
    margin-top: 8px;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.estado-pendiente {
    background-color: #ff4d4d;
    text-align: center;
    color: black; 
    align-items: center;
}

.estado-en-proceso {
    background-color: #ffd700; 
    color: black; 
}

.estado-completo {
    background-color: #4caf50;
}
.tabla{
    border-collapse: collapse;
    margin-top: 20px;

}
.tabla th{
    background-color: #f2f2f2;
    font-weight: bold;
}
.tabla td{
    border: 1px solid #ddd;
    text-align: center;
    position:relative;
    padding: 8px;
}
</style>
<body>
    <h1 style="text-align: center; text-decoration:underline;">Mis libros</h1>
    <form id="formProductCreate" action="/saveProduct" method="POST" enctype="multipart/form-data">
      <div style="display: flex; justify-content: center; border-radius: 0%;">
        <table style="padding-top:1cm;">
          <tr>
            <td rowspan="7">
                <img id="imagenLibro" src="#" alt="imagen"> <hr>
                <!--<form action="/ruta/de/controlador" method="post" enctype="multipart/form-data">-->
                  <label for="imagen">Selecciona una imagen</label>
                  <input type="file" id="imagen" name="imagen" accept="image/*" onchange="cargarImagen()">
             <!-- </form>-->
            </td>
            <td>
              <h3>Titulo del libro</h3>
              <input type="hidden" name="userId" value="<%= usuario.ID %>">
              <input id="TxtTitulo" name="TxtTitulo" class="Barra" type="text" placeholder="Ingrese el titulo del libro..." required>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Autor:</h3>
              <input id="TxtAutor" name="TxtAutor" class="Barra" type="text" placeholder="Ingrese el autor del libro..." required>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Editorial:</h3>
              <input id="TxtEditorial" name="TxtEditorial"  class="Barra" type="text" placeholder="Ingrese la editorial del libro..." required>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Año de Publicación:</h3>
              <input id="TxtAnno" name="TxtAnno" class="Barra" type="text" placeholder="Ingrese el año de publicación..." required>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Idioma:</h3>
              <select class="Selector" id="Idiomas" name="Idiomas">
                <option value="Español">Español</option>
                <option value="Inglés">Inglés</option>
                <option value="Portugués">Portugués</option>
            </select>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Categoría:</h3>
              <select class="Selector" id="Generos" name="Generos">
                <% Generos.forEach(genero => { %>
                    <option value="<%= genero.ID_Genero %>"><%= genero.Genero %></option>
                <% }); %>
            </select>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Precio:</h3>
              <input id="TxtPrecio" name="TxtPrecio" class="Barra" type="number" placeholder="Ingrese un monto..." required>
            </td>
          </tr>
        </table>
      </div>

      <DIV style="text-align: center; ">
        <div  style="display: flex; justify-content: center; padding-top: 0px">
            <table>
                <tr>
                    <td>
                        <H3 style="padding-bottom: 5px; text-align: center;">DETALLES</H3>        
                        <textarea class="Barra" style="height: 100px; text-align: center; align-content: center;" class="Texto" name="Descripcion" id="Descripcion" cols="30" rows="10" placeholder="Añada una breve descripción del libro, su estado, etc." required></textarea> 
                    </td>
                </tr>
            </table>
        </div>
    </form>

    <div style="text-align: center; padding-top: 10px;">
      <button name="Publicar" style="width: 150px; text-align: center;" type="submit" value="Submit">
        Publicar libro
      </button>
    </div>


</DIV>


<div style="display: flex; justify-content: center">
  <table class="tabla" >
      <thead>
          <tr>
              <th >ID</th>
              <th >Libro</th>
              <th >Autor</th>
              <th >Editorial</th>
              <th >Año</th>
              <th >Genero</th>
              <th >Descripción</th>
              <th >Precio</th>
              <th >Estado</th>
              <th >Opciones</th>
          </tr>
      </thead>
      <tbody>
        <% productos.forEach((productos)=>{ %>
          <tr>
              <td><%= productos.ID_Producto %></td>
              <td><%= productos.Nombre %></td>
              <td><%= productos.Autor %></td>
              <td><%= productos.Editorial %></td>
              <td><%= productos.Anno %></td>
              <td><%= productos.Genero %></td>
              <td><%= productos.Descripcion %></td>
              <td><%= productos.Precio %></td>
              <td><%= productos.Estado %></td>
              <td>
                <a href="#" onclick="editar('<%= productos.ID_Producto %>', '<%=usuario.ID %>')">
                  <button type="button">
                    E
                  </button>
                </a>
                <a href="#" onclick="borrar('<%= productos.ID_Producto %>', '<%=usuario.ID %>')">
                  <button type="button" >
                    B
                  </button>
                </a>
              </td>
              
          </tr>
          <% }) %>
      </tbody>
  </table>
</div>


</body>

<footer class="Pie">
  <div class="contenedor">
    <div class="pie-row">
      <div class="pie-links">
        <h4>Quienes somos</h4>
        <ul>
          <li><a href="#">Nosotros</a></li>
          <li><a href="#">Nuestros servicios</a></li>
          <li><a href="#">Politica de privacidad</a></li>
        </ul>
      </div>
      <div class="pie-links">
        <h4>Cuenta</h4>
        <ul>
          <li><a href="/editarUsuario/<%=usuario.ID%>">Cuenta</a></li>
          <li><a href="/carrito/<%=usuario.ID%>">Carrito</a></li>
          <li><a href="#">Compras</a></li>
        </ul>
      </div>
      <div class="pie-links">
        <h4>Tienda</h4>
        <ul>
          <li><a href="/homeVendedor/<%= usuario.ID  %>">Inicio</a></li>
          <li><a href="/Novedades/<%=usuario.ID%>">Novedades</a></li>
        </ul>
      </div>

    </div>
  </div>
</footer>
<script>
document.getElementById('formProductCreate').addEventListener('submit', function (event) {
  if (!validateForm()) {
    event.preventDefault(); 
    Swal.fire({
      icon: 'error',
      title: 'Oops...',
      text: 'Por favor, complete todos los campos del formulario.',
    });
  } else {
    this.submit(); 
    //res.redirect("/Productos/:id");
  }
});

function editar (id,idUsusario){
        console.log("ID:", id);
        console.log("ID Usuario:", idUsusario);
        window.location.href = '/EditarP/' + id + '/' + idUsusario;
                }

function validateForm() {

  const titulo = document.getElementById('TxtTitulo').value;
  const autor = document.getElementById('TxtAutor').value;
  const editorial = document.getElementById('TxtEditorial').value;
  const añoPublicacion = document.getElementById('TxtAnno').value;
  const idioma = document.getElementById('Idiomas').value;
  const categoria = document.getElementById('Generos').value;
  const precio = document.getElementById('TxtPrecio').value;
  const descripcion = document.getElementById('Descripcion').value;

  // Verificar que ninguno de los campos esté vacío
  if (
    titulo.trim() === '' ||
    autor.trim() === '' ||
    editorial.trim() === '' ||
    añoPublicacion.trim() === '' ||
    idioma.trim() === '' ||
    categoria.trim() === '' ||
    precio.trim() === '' ||
    descripcion.trim() === ''
  ) {
    return false;
  }

  return true;
}


  function cargarImagen() {
    var inputImagen = document.getElementById('imagen');
    var imagenLibro = document.getElementById('imagenLibro');


    if (inputImagen.files && inputImagen.files[0]) {
        var reader = new FileReader();

        reader.onload = function (e) {
            imagenLibro.src = e.target.result;
        };

        reader.readAsDataURL(inputImagen.files[0]);
    }
}

function borrar(id,idUsusario) {
            Swal.fire({
                title: 'Esta seguro?',
                text: "Eliminaras el registro permanentemente!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si, eliminar!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location = '/deleteP/' + id+'/'+idUsusario;
                }
            })
        }



</script>
</html>