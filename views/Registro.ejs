<body>
  <h1>Registro</h1>

  <div style="display: flex; justify-content: center">
    <form>

        <label for="ID">Identificación:</label>
        <input class="Barra" type="text" id="ID" name="ID">

        <label for="nombre">Nombre:</label>
        <input class="Barra" type="text" id="nombre" name="nombre">

        <label for="nombre">Apellidos:</label>
        <input class="Barra" type="text" id="apellidos" name="apellidos">

        <label for="Teléfono">Teléfono:</label>
        <input class="Barra" type="text" id="Teléfono" name="Teléfono">

        <label for="email">Correo Electrónico:</label>
        <input class="Barra" type="email" id="email" name="email" required>

        <label for="password">Contraseña:</label>
        <input class="Barra" type="password" id="password" name="password" required>

        <label for="confirm_password">Confirmar Contraseña:</label>
        <input class="Barra" type="password" id="confirm_password" name="confirm_password" required>

        <label for="Nacimiento">Fecha de nacimiento:</label>
        <input class="Barra" type="date" id="Nacimiento" name="Nacimiento">
        <button type="submit">Registrarse</button>
        
    </form>
    
  </div>

