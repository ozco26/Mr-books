<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Pedidos - Admin</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstiloPedido.css" />
    <script src="/FuncionesBotones/BotónBuscarPedido.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<header class="header">
  <div class="logo">
    <a href="Home.html">
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="Home.html">
      <img src="/Recursos/Home.png" alt="Home">
    </a>
    <a class="MENUA" href="Cuenta.html">
      <img src="/Recursos/User.png" alt="Cuenta">
    </a>
    <a class="MENUA" href="Carrito.html">
      <img src="/Recursos/Carrito.png" alt="">
    </a>
  </nav>
</header>
<body>
  <div class="pedido">
        <br>
        <h1>Gestión de Pedidos - Admin</h1>
        <br>
        <div class="filters">
            <label for="filtroPedido">Buscar por Número de Pedido:</label>
            <input type="text" id="filtroPedido" name="filtroPedido" placeholder="Número de Pedido">
            <button id="btnBuscar" onclick="buscarPedido()">Buscar</button>
            <button id="btnVolver" onclick="Volver()">Volver</button>
        </div>

        <!--Función para el botón Buscar pedido-->
        <script>
          function buscarPedido() {
              var numeroPedido = document.getElementById('filtroPedido').value;
              var filas = document.querySelectorAll('.content tbody tr');
              filas.forEach(function(fila) {
                  fila.style.display = 'none';
              });
      
              if (!numeroPedido) {
                  filas.forEach(function(fila) {
                      fila.style.display = '';
                  });
                  return;
              }
              filas.forEach(function(fila) {
                  var numeroPedidoFila = fila.cells[0].textContent;
                  if (numeroPedidoFila === numeroPedido) {
                      fila.style.display = '';
                  }
              });
          }
       </script> 
<!--Función para el botón Volver en Pedido-->
    <script>
      function Volver() {
        var filas = document.querySelectorAll('.content tbody tr');
        filas.forEach(function(fila) {
            fila.style.display = '';
        });
        document.getElementById('filtroPedido').value = '';
    }
    </script>

  <div class="estados">
    <h2>Estado de Pedidos</h2>
    <br>
        <tr>
            <span>Todos (<%= pedidos.length %>)</span>
        </tr>
        <tr>
            <span> 1. Pendiente (<%= pedidos.filter(pedido => pedido.Estado === 1).length %>)</span>
        </tr>
        <tr>
          <span> 2. En Proceso (<%= pedidos.filter(pedido => pedido.Estado === 2).length %>)</span>
      </tr>
      <tr>
        <span>3. Completado (<%= pedidos.filter(pedido => pedido.Estado === 3).length %>)</span>
      </tr>
  </div>
  <div class="content">
        <table>
            <thead>
                <tr>
                    <th>Número de Pedido</th>
                    <th>Producto</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
              <% pedidos.forEach((pedidos)=>{ %>
                <tr>
                    <td><%= pedidos.ID_Pedido %></td>
                    <td><%= pedidos.Producto %></td>
                    <td><%= pedidos.Cliente %></td>
                    <td><%= pedidos.Fecha %></td>
                    <td><%= pedidos.Estado %></td>          
                    <td>
                      <a href="#" onclick="editar('<%= pedidos.ID_Pedido %>', '<%=usuario %>')" >Editar</i></a>
                      <a href="#" onclick="borrar('<%= pedidos.ID_Pedido %>', '<%=usuario %>')" >Borrar</i></a>
                    </td>
              </tr>
                <% }) %>
            </tbody>          
        </table>  
    </div>

    <footer class="Pie">
      <div class="contenedor">
        <div class="pie-row">
          <div class="pie-links">
            <h4>Quienes somos</h4>
            <ul>
              <li><a href="#">Nosotros</a></li>
              <li><a href="#">Nuestros servicios</a></li>
              <li><a href="#">Politica de privacidad</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Cuenta</h4>
            <ul>
              <li><a href="#">Cuenta</a></li>
              <li><a href="#">Carrito</a></li>
              <li><a href="#">Compras</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Tienda</h4>
            <ul>
              <li><a href="#">Inicio</a></li>
              <li><a href="#">Novedades</a></li>
              <li><a href="#">Categorias</a></li>
            </ul>
          </div>
          
        </div>
      </div>
    </footer>
</body>

<script>
  function goBack() {
      window.history.back();
  }

  function borrar(id,usuario) {
          Swal.fire({
              title: 'Está seguro?',
              text: "Eliminaras el registro permanentemente!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#3085d6',
              cancelButtonColor: '#d33',
              confirmButtonText: 'Si, eliminar!'
          }).then((result) => {
              if (result.isConfirmed) {
                  window.location = '/deletePedidos/' + id+'/'+usuario;
              }
          })
  }

  function editar (id,idUsusario){
      console.log("ID:", id);
      console.log("ID Usuario:", idUsusario);
      window.location = '/editar/' + id + '/' + idUsusario;
  }
 
   function obtenerIdDeUsuario(){
      return id;
  }
  const userId = obtenerIdDeUsuario(); 
</script>

</html>
