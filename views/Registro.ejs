<body><br>
 
  <h1>Registro</h1>

  <div style="display: flex; justify-content: center">
    <form  id="formUserCreate" action="/saveReg" method="POST"> 

        <label for="id">Cédula:</label>
        <input class="Barra" type="text" id="cedula" name="cedula" tabindex="1">

        <label for="nombre">Nombre:</label>
        <input class="Barra" type="text" id="nombre" name="nombre" tabindex="2"> 

        <label for="nombre">Apellidos:</label>
        <input class="Barra" type="text" id="apellidos" name="apellidos" tabindex="3">

        <label for="telefono">Teléfono:</label>
        <input class="Barra" type="text" id="telefono" name="telefono" tabindex="4">

        <label for="email">Correo Electrónico:</label>
        <input class="Barra" type="email" id="email" name="email" tabindex="5">

        <label for="password">Contraseña:</label>
        <input class="Barra" type="password" id="password" name="password" tabindex="6">

        <label for="confirm_password">Confirmar Contraseña:</label>
        <input class="Barra" type="password" id="confirm_password" name="confirm_password" tabindex="7">

        <label for="nacimiento">Fecha de nacimiento:</label>
        <input class="Barra" type="date" id="nacimiento" name="nacimiento" tabindex="8">
        <br>
        <input type="hidden" id="rol" name="rol" value="2" tabindex="9">
        <input type="hidden" id="fRegistro" name="fRegistro" value="" tabindex="10">
        

        <button type="submit" tabindex="11">Registrarse</button>
        
    </form>
    
