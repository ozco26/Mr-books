<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Página principal</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosCarrito.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


</head>
<header class="header">
  <div class="logo">
    <a href="/homecliente/<%=idUsuario %>">
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>

    <a class="MENUA" href="#">
      <img src="/Recursos/User.png" alt="">
    </a>
    <a class="MENUA" href="Carrito.html">
      <img src="/Recursos/Carrito.png" alt="">
    </a>
  </nav>
</header>

  <body>
    <h1>Mi carrito</h1>
    <div style="display: flex; justify-content: center; align-items: center">
      <table class="tabla">
        <thead style="background-color: lightgray">
          <tr>
            <th>Libro</th>
            <th>Autor</th>
            <th>Editorial</th>
            <th>Año</th>
            <th>Idioma</th>
            <th>Precio</th>
            <th>Eliminar</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((items)=>{ %>
          <tr>
            <td><%= items.Nombre %></td>
            <td><%= items.Autor %></td>
            <td><%= items.Editorial %></td>
            <td><%= items.Anno %></td>
            <td><%= items.Idioma %></td>
            <td><%= items.Precio %> + IVA</td>

            <td>
              <a
                href=""
                onclick="pago('<%= items.ID_Producto %>', '<%=idUsuario %>') ; return false;"
              >
                <button type="button">B</button>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="resumen">
      <div class="fila">
        <span class="etiqueta">Subtotal: ₡ </span>
        <span class="valor" id="subtotal"><%= subtotal %> </span>
      </div>
      <div class="fila">
        <span class="etiqueta">IVA: ₡</span>
        <span class="valor" id="iva"><%= IVA %></span>
      </div>
      <div class="fila">
        <span class="etiqueta">TOTAL: ₡</span>
        <span class="valor" id="total"><%= total %></span>
      </div>
    </div>

<div class="pago">
  <a href="/Pago/<%=idUsuario %>/<%=carrito.ID_Carrito%>">
    <button class="checkout-btn" >Realizar Pago</button>
  </a>
</div>
      <footer class="Pie">
        <div class="contenedor">
          <div class="pie-row">
            <div class="pie-links">
              <h4>Quienes somos</h4>
              <ul>
                <li><a href="#">Nosotros</a></li>
                <li><a href="#">Nuestros servicios</a></li>
                <li><a href="#">Politica de privacidad</a></li>
              </ul>
            </div>
            <div class="pie-links">
              <h4>Cuenta</h4>
              <ul>
                <li><a href="#">Cuenta</a></li>
                <li><a href="#">Carrito</a></li>
                <li><a href="#">Compras</a></li>
              </ul>
            </div>
            <div class="pie-links">
              <h4>Tienda</h4>
              <ul>
                <li><a href="#">Inicio</a></li>
                <li><a href="#">Novedades</a></li>
                <li><a href="#">Categorias</a></li>
              </ul>
            </div>
            
          </div>
        </div>
      </footer>
      
      <script>
        function borrar(idProducto,idUsuario) {

            Swal.fire({
                title: 'Esta seguro?',
                text: "Eliminaras el libro de tu carrito dejando libre el mismo!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si, eliminar!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location = '/deleteItemCarrito/' + idProducto+'/'+idUsuario;
                }
            })
        }
      </script>
    
</body>


</html>
