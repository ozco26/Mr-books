<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Editar usuario - Administrador</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosCuenta.css" />
</head>
<header class="header">
  <div class="logo">
    <a href='/homecliente/<%=usuario.ID%>'>
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/" title="Cerrar Sesion">
      <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
      </a>
    <a class="MENUA" href="/carrito/<%=usuario.ID%>" title="Carrito de Compras">
      <img src="/Recursos/Carrito.png" alt="Carrito de Compras">
    </a>
  </nav>
</header>
<body>
    <br>
    <h1>¿Quieres Modificar tus datos <%= usuario.Nombre %> </h1>
    <br>
    <h5>Es este espacio podrás modificar datos personales y selecciona el rol.</h5>
    <br>
    <form id="formUsrEd" action="/updateUserbyUser" method="POST">
<div>
        <input class="Barra" type="text" id="id" name="id"  value="<%= usuario.ID %>" style="display: none;" >


        <input class="Barra" type="text" id="cedula" name="cedula" value="<%= usuario.Cedula %>" style="display: none;"  required>

        <label for="nombre">Nombre:</label>
        <input class="Barra" type="text" id="nombre" name="nombre" placeholder="Ingrese su nombre" value="<%= usuario.Nombre %>" required>

        <label for="apellido">Apellidos:</label>
        <input class="Barra" type="text" id="apellidos" name="apellidos" placeholder="Ingrese sus apellidos" value="<%= usuario.Apellidos %>">

        <label for="telefono">Teléfono:</label>
        <input class="Barra" type="text" id="telefono" name="telefono" placeholder="Ingrese su número de teléfono" value="<%= usuario.Telefono %>">

   
        <input class="Barra" type="text" id="correo" name="correo" value="<%= usuario.Correo %>" placeholder="Ingrese el correo" style="display: none;" required>

        <label for="contrasenna">Contrasenna:</label>
        <input class="Barra" type="password" id="contrasenna" name="contrasenna" placeholder="Ingrese la Contraseña" required >

      


        <div >
          
          <select id="rol" name="rol" class="form-select" aria-label="Default select example" style="display: none;">
              <option <%= usuario.Rol=='1' ? "selected" : '' %> value="1">Admin</option>
              <option <%= usuario.Rol=='2' ? "selected" : '' %> value="2">Cliente</option>
              <option <%= usuario.Rol=='3' ? "selected" : '' %> value="3">Vendedor</option>
              <option <%= usuario.Rol=='4' ? "selected" : '' %> value="4">Bloqueado</option>
            </select>
          </div>
        
        

        <button type="submit">Guardar</button>
        <a href='/homecliente/<%=usuario.ID%>'><button type="button">Cancelar</button> </a>

      </div>
    </form>
    <footer class="Pie">
      <div class="contenedor">
        <div class="pie-row">
          <div class="pie-links">
            <h4>Quienes somos</h4>
            <ul>
              <li><a href="#">Nosotros</a></li>
              <li><a href="#">Nuestros servicios</a></li>
              <li><a href="#">Politica de privacidad</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Cuenta</h4>
            <ul>
              <li><a href="/editarUsuario/<%=usuario.ID%>">Cuenta</a></li>
              <li><a href="/carrito/<%=usuario.ID%>">Carrito</a></li>
              <li><a href="#">Compras</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Tienda</h4>
            <ul>
              <li><a href="/homecliente/<%=usuario.ID%>">Inicio</a></li>
              <li><a href="/Novedades/<%=usuario.ID%>">Novedades</a></li>
            </ul>
          </div>       
        </div>
      </div>
    </footer>
</body>
<script>

</script>

</html>