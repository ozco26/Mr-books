<head>
  <meta charset="UTF-8">
  <title>Página principal - Cliente</title>
  <link rel="stylesheet" href="/Estilos/Estilos.Css" />
</head>
<header class="header">
  <div class="logo">
    <a href='/homecliente/<%=usuario.ID%>' title="Home" >
      <img src="/Recursos/Logo.png" alt="Home" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/" title="Cerrar Sesion">
      <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
    </a>
    <a class="MENUA" href="/editarUsuario/<%=usuario.ID%>" title="Cuenta de Usuario">
      <img src="/Recursos/User.png" alt="Cuenta">
    </a>
    <a class="MENUA" href="/carrito/<%=usuario.ID%>" title="Carrito de Compras">
      <img src="/Recursos/Carrito.png" alt="Carrito de Compras">
    </a>
  </nav>
</header>
<body>
<br> 
<h4 style="text-align: center;">Hola <%= usuario?.Nombre %>, es un gusto tenerte de vuelta! </h4>
<h5 style="text-align: center;">Como podemos ayudarte?</h5>
<br>
<div class="slider-frame">
  <ul>
    <li>
      <a href="/Historia/<%=usuario.ID%>">
        <img src="Recursos/Ofertas especiales.png" alt="">
      </a>
    </li>
    <li>
      <a href="/Escolar/<%=usuario.ID%>">
        <img src="Recursos/Educativo.png" alt="">
      </a>
    </li>

    <li>
      <a href="/Infantil/<%=usuario.ID%>">
        <img src="Recursos/Infantil.png" alt="">
      </a>
    </li>

    <li>
      <a href="/Terror/<%=usuario.ID%>">
        <img src="Recursos/Terror.png" alt="">
      </a>
    </li>
  </ul>
</div>
<br>
<div style="display: flex; justify-content: center">
  <form id="formularioBusqueda" action="/formularioBusqueda" method="POST">
    <div class="Barra">
      
      <input type="text" name="txtBusqueda" placeholder="Buscar...">

        <button style="border: 0ch;"  type="submit" >
          <img style="background-color: #E1C2A1;" src="/Recursos/Lupa.png" alt="Buscar" width="30px" ; >
        </button>
        <input class="Barra" type="text" id="txtIdUsuario1" name="txtIdUsuario1" value="<%= usuario.ID  %>"
        style="display: none;">
    </div>
  </form>  
    <div style="padding: 10px;">
      <button style="padding: 10px;" id="mostrarFormulario" class="boton-efecto" onclick="mostrarFormulario()"> Búsqueda
        Avanzada</button>
    </div>
  </div>
  <div class="oculto" id="contenedorFormulario" style="padding: 20px;">
    <fieldset>
      <legend>Busqueda Avanzada</legend>

      <h4 style="text-align: center;">Coloque la información que necesita filtrar</h4>
      <br>
      <form id="formularioBusquedaAvanzada" action="/formularioBusquedaAvanzada" method="POST">
        <!-- Contenido del formulario de búsqueda avanzada -->
        <div class="row" style="justify-content: center;">
          <input class="Barra" type="text" id="txtNombre" name="txtNombre" placeholder="Ingrese el nombre del libro">
          <input class="Barra" type="text" id="txtAutor" name="txtAutor" placeholder="Ingrese el nombre del autor">
          <input class="Barra" type="text" id="txtEditorial" name="txtEditorial" placeholder="Ingrese la editorial">
          <input class="Barra" type="text" id="txtAnno" name="txtAnno" placeholder="Ingrese el año de publicación">
          <input class="Barra" type="text" id="txtGenero" name="txtGenero" placeholder="Ingrese el género">
          <input class="Barra" type="text" id="txtIdUsuario" name="txtIdUsuario" value="<%=usuario.ID%>"
            style="display: none;">
        </div>
        <br>

        <!-- Otros campos de formulario... -->
        <div style="padding: 10px; text-align: center;">
          <button class="boton-efecto" type="submit">Buscar</button>
        </div>
      </form>
  </div>
  </fieldset>
  <br>

  
  <div class="Catalogo">
    <a class="CatalogoA" href="/libro/<%= productos[0]?.ID_Producto %>/<%= usuario.ID%>">
      <img src="<%= productos[0]?.direccionImg %>" alt="<%= productos[0]?.Nombre %>" title="<%= productos[0]?.Nombre %>" height="300"
          width="300">
      <p><%= productos[0]?.Nombre %></p>
    </a>
    <a class="CatalogoA" href="/libro/<%= productos[1]?.ID_Producto %>/<%=  usuario.ID%>">
      <img src="<%= productos[1]?.direccionImg %>" alt="<%= productos[1]?.Nombre %>" title="<%= productos[1]?.Nombre %>" height="300"
          width="300">
      <p><%= productos[1]?.Nombre %></p>
    </a>
    <a class="CatalogoA" href="/libro/<%= productos[2]?.ID_Producto %>/<%=  usuario.ID%>">
      <img src="<%= productos[2]?.direccionImg %>" alt="<%= productos[2]?.Nombre %>" title="<%= productos[2]?.Nombre %>" height="300"
          width="300">
      <p><%= productos[2]?.Nombre %></p>
    </a>
    <a class="CatalogoA" href="/libro/<%= productos[3]?.ID_Producto %>/<%=  usuario.ID%>">
      <img src="<%= productos[3]?.direccionImg %>" alt="<%= productos[3]?.Nombre %>" title="<%= productos[3]?.Nombre %>" height="300"
          width="300">
      <p><%= productos[3]?.Nombre %></p>
    </a>
    <a class="CatalogoA" href="/libro/<%= productos[4]?.ID_Producto %>/<%=  usuario.ID%>">
      <img src="<%= productos[4]?.direccionImg %>" alt="<%= productos[4]?.Nombre %>" title="<%= productos[4]?.Nombre %>" height="300"
          width="300">
      <p><%= productos[4]?.Nombre %></p>
    </a>
</div>


  <footer class="Pie">
    <div class="contenedor">
      <div class="pie-row">
        <div class="pie-links">
          <h4>Quienes somos</h4>
          <ul>
            <li><a href="#">Nosotros</a></li>
            <li><a href="#">Nuestros servicios</a></li>
            <li><a href="#">Politica de privacidad</a></li>
          </ul>
        </div>
        <div class="pie-links">
          <h4>Cuenta</h4>
          <ul>
            <li><a href="/editarUsuario/<%=usuario.ID%>">Gestione su Cuenta</a></li>
            <li><a href="/carrito/<%=usuario.ID%>">Carrito</a></li>
            <li><a href="#">Compras</a></li>
          </ul>
        </div>
        <div class="pie-links">
          <h4>Tienda</h4>
          <ul>
            <li><a href="/homecliente/<%=usuario.ID%>">Inicio</a></li>
            <li><a href="/Novedades/<%=usuario.ID%>">Novedades</a></li>
            <li><a href="#">Categorias</a></li>
          </ul>
        </div>
  
      </div>
    </div>
  </footer>

</body>
<script>
document.getElementById("irhome").addEventListener("click", function(event) {
  event.preventDefault(); // Evitar el comportamiento predeterminado del enlace
  window.location.href = window.location.href;
});

function mostrarFormulario() {
    var contenedorFormulario = document.getElementById('contenedorFormulario');
    contenedorFormulario.style.display = 'block'; // O 'flex', o cualquier valor deseado
  }
</script>
