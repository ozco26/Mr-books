<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Editar usuario - Administrador</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosCuenta.css" />
</head>
<header class="header">
  <div class="logo">
    <a href="/homeAdmnin/<%=idUsuario %>">
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/" title="Cerrar Sesion">
      <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
    </a>

  </nav>
</header>
<body>
    <br>
    <h1>¿Quieres Modificar el usuario <%= usuario.ID %> </h1>
    <br>
    <h5>Es este espacio podrás modificar datos personales y seleccionar el rol.</h5>
    <br>
    <form id="formAdmEd" action="/updateUserbyAdmin" method="POST">
      <div>
        

        <label for="nombre">Cedula:</label>
        <input class="Barra" type="text" name="cedula"  value="<%= usuario.Cedula %>" style="display: none;" required>

        <label for="nombre">Nombre:</label>
        <input class="Barra" type="text" name="nombre" placeholder="Ingrese su nombre" value="<%= usuario.Nombre %>" required>

        <label for="apellido">Apellidos:</label>
        <input class="Barra" type="text" name="apellidos"  placeholder="Ingrese sus apellidos" value="<%= usuario.Apellidos %>" required>

        <label for="telefono">Teléfono:</label>
        <input class="Barra" type="text" name="telefono"  placeholder="Ingrese su número de teléfono" value="<%= usuario.Telefono %>" required>

        <label for="telefono">Correo:</label>
        <input class="Barra" type="text" name="correo"  value="<%= usuario.Correo %>" placeholder="Ingrese el correo" required  >

        <label for="telefono">Contrasenna:</label>
        <input class="Barra" type="password" name="contrasenna" required placeholder="Ingrese la Contraseña"  >
        <input class="Barra" type="text" name="IDADminsitrador" value="'<%=idUsuario %>'" style="display: none;" >
        <input class="Barra" type="text" name="id" value="<%=usuario.ID %>" style="display: none;" >
        
       

        <div >
          <label for="rol" class="form-label">Rol</label>
          <select  name="rol" class="form-select" aria-label="Default select example">
              <option <%= usuario.Rol=='1' ? "selected" : '' %> value="1">Admin</option>
              <option <%= usuario.Rol=='2' ? "selected" : '' %> value="2">Cliente</option>
              <option <%= usuario.Rol=='3' ? "selected" : '' %> value="3">Vendedor</option>
              <option <%= usuario.Rol=='4' ? "selected" : '' %> value="4">Bloqueado</option>
            </select>
          </div>
        
          <input class="Barra" type="date" name="Fecha_ingreso" value="<%= usuario.Fecha_ingreso %>" style="display: none;">

        <button type="submit">Guardar</button>
        <a href="/GestionClientes/<%=idUsuario %>"><button type="button">Cancelar</button> </a>
      </div>
      </form>
    <footer class="Pie">
      <div class="contenedor">
        <div class="pie-row">
          <div class="pie-links">
            <h4>Quienes somos</h4>
            <ul>
              <li><a href="/nosotros">Nosotros</a></li>
              <li><a href="/nuestrosServicios">Nuestros servicios</a></li>
              <li><a href="/politicaPrivacidad">Politica de privacidad</a></li>
            </ul>
          </div>
          
        </div>
      </div>
    </footer>
</body>


</html>