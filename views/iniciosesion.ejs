<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Página principal</title>
    <link rel="stylesheet" href="Estilos/Estilos.Css" />
    <link rel="stylesheet" href="Estilos/EstilosCuenta.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<header class="header">
  <div class="logo">
    <a href="/">
      <img src="Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    </a>
    <a class="MENUA" href="inicioSesion"  title="Login">
      <img src="Recursos/User.png" alt="Inicio de sesión">
    </a>
    <a class="MENUA" href="registro"  title="Registro">
      <img  src="Recursos/UserRegistro.png" alt="Registro">
    </a>
  </nav>
</header>
<body>
  <% var mostrarMensaje ; %>
    <% var popupMessage %>
    <div id="oculto" style{"<%= mostrarMensaje ? 'display: block;' : 'display: none;' %>"}></div>
    <br>
    <h1>Inicio de sesión</h1>
    <br>
    <h5>Por favor introduzca su usuario y contraseña para el inicio de sesión
    </h5>
    <br>
    <div style="display: flex; justify-content: center">
    <form id="formLogin" action="/login" method="POST">
        <label for="nombre">Usuario:</label>
        <input class="Barra" type="email" id="email" name="email" placeholder="Ingrese su email">

        <label for="contraseña">Contraseña:</label>
        <input class="Barra" type="password" id="contrasena" name="contrasena" placeholder="Ingrese su contraseña">
        <button type="submit">Ingresar</button>
        <a href="registro">
          <h5>¿Es un nuevo cliente? Cree una cuenta</h5>
        </a>
        
    </form>
    
  </div>
    <footer class="Pie">
      <div class="contenedor">
        <div class="pie-row">
          <div class="pie-links">
            <h4>Quienes somos</h4>
            <ul>
              <li><a href="/nosotros">Nosotros</a></li>
              <li><a href="/nuestrosServicios">Nuestros servicios</a></li>
              <li><a href="/politicaPrivacidad">Politica de privacidad</a></li>
            </ul>
          </div>
          
          <div class="pie-links">
            <h4>Tienda</h4>
            <ul>
              <li><a href="/">Inicio</a></li>
              <li><a href="/Novedades/">Novedades</a></li>
            </ul>
          </div>       
        </div>
      </div>
    </footer>
</body>

<script>
  document.addEventListener('DOMContentLoaded', function() {
        const mensaje = "<%= popupMessage %>";
        if (mensaje) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: mensaje
            });
        }
    });
</script>


</html>