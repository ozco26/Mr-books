<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosCRUDP.css">
    <title>Editar libro</title>
</head>
<header class="header">
  <div class="logo">
    <a href="Home.html" title="Home">
      <img src="/Recursos/Logo.png" alt="Home" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/homeVendedor/<%= idUsusario  %>" title="Home">
      <img src="/Recursos/Home.png" alt="Home">
    </a>
    <a class="MENUA" href="/editarUsuario/<%=idUsusario%>" title="Cuenta de Usuario">
      <img src="/Recursos/User.png" alt="Cuenta">
    </a>
    <a class="MENUA" href="/carrito/<%=idUsusario%>" title="Carrito de Compras">
      <img src="/Recursos/Carrito.png" alt="Carrito de Compras">
    </a>
  </nav>
</header>
<body>
    <h1 style="text-align: center; text-decoration:underline;">Editar libro</h1>
    <form id="EditarLibro" action="/updateLibros" method="POST">
      <div style="display: flex; justify-content: center; border-radius: 0%;">
        <table style="padding-top:1cm;">
          <tr>
            <td rowspan="7">
                <img id="imagenLibro" src="#" alt="imagen"> <hr>
                <form action="/ruta/de/controlador" method="post" enctype="multipart/form-data">
                  <label for="imagen">Selecciona una imagen</label>
                  <input type="file" id="imagen" name="imagen" accept="image/*" onchange="cargarImagen()">
              </form>
            </td>
            <td>
              <h3>Titulo del libro</h3>
              <input type="hidden" name="userId" value="<%= idUsusario %>">
              <input type="hidden" name="id" value="<%= producto.ID_Producto %>">
              <input id="TxtTitulo" name="TxtTitulo" class="Barra" type="text" value="<%= producto.Nombre %>" placeholder="Ingrese el titulo del libro...">
            </td>
          </tr>
          <tr>
            <td>
              <h3>Autor:</h3>
              <input id="TxtAutor" name="TxtAutor" class="Barra" type="text" value="<%= producto.Autor %>" placeholder="Ingrese el autor del libro..." >
            </td>
          </tr>
          <tr>
            <td>
              <h3>Editorial:</h3>
              <input id="TxtEditorial" name="TxtEditorial" value="<%= producto.Editorial %>"  class="Barra" type="text" placeholder="Ingrese la editorial del libro..." >
            </td>
          </tr>
          <tr>
            <td>
              <h3>Año de Publicación:</h3>
              <input id="TxtAño" name="TxtAño" class="Barra" value="<%= producto.Anno %>" type="text" placeholder="Ingrese el año de publicación...">
            </td>
          </tr>
          <tr>
            <td>
              <h3>Idioma:</h3>
              <select class="Selector" id="Idiomas" name="Idiomas">
                <option value="Español">Español</option>
                <option value="Inglés">Inglés</option>
                <option value="Portugués">Portugués</option>
            </select>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Categoría:</h3>
              <select class="Selector" id="Generos" name="Generos">
                <% Generos.forEach(genero => { %>
                    <option value="<%= genero.ID_Genero %>"><%= genero.Genero %></option>
                <% }); %>
            </select>
            </td>
          </tr>
          <tr>
            <td>
              <h3>Precio:</h3>
              <input id="TxtPrecio" value="<%= producto.Precio %>" name="TxtPrecio" class="Barra" type="number" placeholder="Ingrese un monto...">
            </td>
          </tr>
        </table>
      </div>

      <DIV style="text-align: center; ">
        <div  style="display: flex; justify-content: center; padding-top: 0px">
            <table>
                <tr>
                    <td>
                        <H3 style="padding-bottom: 5px; text-align: center;">DETALLES</H3>        
                        <textarea class="Barra" style="height: 100px; text-align: center; align-content: center;" class="Texto" name="Descripción" id="Descripción" cols="30" rows="10" placeholder="Añada una breve descripción del libro, su estado, etc.">
                            <%= producto.Descripcion %>
                        </textarea> 
                    </td>
                </tr>
            </table>
        </div>
        <div style="text-align: center; padding-top: 10px;">
          <button name="Publicar" style="width: 150px; text-align: center;" type="submit" value="Submit">
            Editar libro
          </button>
        </div>
    </form>

    


</DIV>
    
</body>
<footer class="Pie">
  <div class="contenedor">
    <div class="pie-row">
      <div class="pie-links">
        <h4>Quienes somos</h4>
        <ul>
          <li><a href="#">Nosotros</a></li>
          <li><a href="#">Nuestros servicios</a></li>
          <li><a href="#">Politica de privacidad</a></li>
        </ul>
      </div>
      <div class="pie-links">
        <h4>Cuenta</h4>
        <ul>
          <li><a href="/editarUsuario/<%=idUsusario%>">Cuenta</a></li>
          <li><a href="/carrito/<%=idUsusario%>">Carrito</a></li>
          <li><a href="#">Compras</a></li>
        </ul>
      </div>
      <div class="pie-links">
        <h4>Tienda</h4>
        <ul>
          <li><a href="/homeVendedor/<%= idUsusario  %>">Inicio</a></li>
          <li><a href="/Novedades/<%=idUsusario%>">Novedades</a></li>
        </ul>
      </div>

    </div>
  </div>
</footer>
</html>