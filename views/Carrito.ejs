<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Página principal</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosCarrito.css" />
    
    <link rel="stylesheet" href="/https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />

</head>
<header class="header">
  <div class="logo">
    <a href="/">
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/">
      <img src="/Recursos/Home.png" alt="Home">
    </a>
    <a class="MENUA" href="#">
      <img src="/Recursos/User.png" alt="">
    </a>
    <a class="MENUA" href="Carrito.html">
      <img src="/Recursos/Carrito.png" alt="">
    </a>
  </nav>
</header>

<body>
  <h1>Mi carrito</h1>
  <div style="display: flex;   justify-content: center; align-items: center;" >
    <table class="tabla" >
        <thead style="background-color: lightgray;">
            <tr>
                
                <th >Libro</th>
                <th >Autor</th>
                <th >Editorial</th>
                <th >Año</th>
                <th>Idioma</th>
                <th >Precio</th>
                <th >Eliminar</th>

            </tr>
        </thead>
        <tbody>
          <% items.forEach((items)=>{ %>
            <tr>
                <td><%=  items.Nombre %></td>
                <td><%= items.Autor %></td>
                <td><%= items.Editorial %></td>
                <td><%= items.Anno %></td>
                <td><%= items.Idioma %></td>
                <td><%= items.Precio %> + IVA</td>

                <td>
              
                  <a href="#" onclick="borrar()">
                    <button type="button" >
                      B
                    </button>
                  </a>
                </td>
                
            </tr>
          <% }) %>
        </tbody>
    </table>
  </div>



<div class="resumen">
  <div class="fila">
      <span class="etiqueta">Subtotal: ₡  </span>
      <span class="valor" id="subtotal"><%= subtotal %> </span>
  </div>
  <div class="fila">
      <span class="etiqueta">IVA: ₡</span>
      <span class="valor" id="iva"><%= IVA %></span>
  </div>
  <div class="fila">
      <span class="etiqueta">TOTAL: ₡</span>
      <span class="valor" id="total"><%= total %></span>
  </div>
</div>

<div class="pago">
  <a href="Pago.html">
    <button class="checkout-btn">Realizar Pago</button>
  </a>
</div>
      <footer class="Pie">
        <div class="contenedor">
          <div class="pie-row">
            <div class="pie-links">
              <h4>Quienes somos</h4>
              <ul>
                <li><a href="#">Nosotros</a></li>
                <li><a href="#">Nuestros servicios</a></li>
                <li><a href="#">Politica de privacidad</a></li>
              </ul>
            </div>
            <div class="pie-links">
              <h4>Cuenta</h4>
              <ul>
                <li><a href="#">Cuenta</a></li>
                <li><a href="#">Carrito</a></li>
                <li><a href="#">Compras</a></li>
              </ul>
            </div>
            <div class="pie-links">
              <h4>Tienda</h4>
              <ul>
                <li><a href="#">Inicio</a></li>
                <li><a href="#">Novedades</a></li>
                <li><a href="#">Categorias</a></li>
              </ul>
            </div>
            
          </div>
        </div>
      </footer>
      
      <script src="Javascript/Carrito.js"></script>
    
</body>


</html>