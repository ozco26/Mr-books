<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Editar usuario - Administrador</title>
    <link rel="stylesheet" href="/Estilos/Estilos.Css" />
    <link rel="stylesheet" href="/Estilos/EstilosCuenta.css" />
</head>
<header class="header">
  <div class="logo">
    <a href="/GestionClientes/'<%=idUsuario %>'">
      <img src="/Recursos/Logo.png" alt="Logo" />
    </a>
  </div>
  <nav>
    <a class="MENUA" href="/" title="Cerrar Sesion">
      <img src="/Recursos/cerrarSesion.png" alt="Cerrar Sesion">
    <a class="MENUA" href="Cuenta.html" title="Cuenta de Usuario">
      <img src="/Recursos/User.png" alt="Cuenta">
    </a>
    <a class="MENUA" href="Carrito.html" title="Carrito de Compras">
      <img src="/Recursos/Carrito.png" alt="Carrito de Compras">
    </a>
  </nav>
</header>
<body>
    <br>
    <h1>¿Quieres Modificar del usuario <%= usuario.ID %> </h1>
    <br>
    <h5>Es este espacio podrás modificar datos personales y seleccionar el rol.</h5>
    <br>
    <form id="formAdmEd" action="/updateUserbyAdmin" method="POST">
        <input class="Barra" type="text" id="IDADminsitrador" value="'<%=idUsuario %>'" style="display: none;" >
        <input class="Barra" type="text" id="ID" value="<%= usuario.ID %>" style="display: none;" >

        <label for="nombre">Cedula:</label>
        <input class="Barra" type="text" id="cedula"  value="<%= usuario.Cedula %>" style="display: none;" required>

        <label for="nombre">Nombre:</label>
        <input class="Barra" type="text" id="nombre" placeholder="Ingrese su nombre" value="<%= usuario.Nombre %>" required>

        <label for="apellido">Apellidos:</label>
        <input class="Barra" type="text" id="apellido"  placeholder="Ingrese sus apellidos" value="<%= usuario.Apellidos %>" required>

        <label for="telefono">Teléfono:</label>
        <input class="Barra" type="text" id="telefono"  placeholder="Ingrese su número de teléfono" value="<%= usuario.Telefono %>" required>

        <label for="telefono">Correo:</label>
        <input class="Barra" type="text" id="correo"  value="<%= usuario.Correo %>" placeholder="Ingrese el correo" required  >

        <label for="telefono">Contrasenna:</label>
        <input class="Barra" type="password" id="contrasenna" required placeholder="Ingrese la Contraseña"  >

        
        <input class="Barra" type="text" id="fecha_nacimiento" value="<%= usuario.Fecha_nacimiento %>" placeholder="Ingrese la fecha de nacimiento" >

        <div >
          <label for="rol" class="form-label">Rol</label>
          <select id="rol" name="rol" class="form-select" aria-label="Default select example">
              <option <%= usuario.Rol=='1' ? "selected" : '' %> value="1">Admin</option>
              <option <%= usuario.Rol=='2' ? "selected" : '' %> value="2">Cliente</option>
              <option <%= usuario.Rol=='3' ? "selected" : '' %> value="3">Vendedor</option>
              <option <%= usuario.Rol=='4' ? "selected" : '' %> value="4">Bloqueado</option>
            </select>
          </div>
        
        <input class="Barra" type="text" id="Fecha_ingreso" value="<%= usuario.Fecha_ingreso %>" style="display: none;" >

        <button type="submit">Guardar</button>
        <a href="/GestionClientes/'<%=idUsuario %>'"><button type="button">Cancelar</button> </a>
        
    </form>
    <footer class="Pie">
      <div class="contenedor">
        <div class="pie-row">
          <div class="pie-links">
            <h4>Quienes somos</h4>
            <ul>
              <li><a href="#">Nosotros</a></li>
              <li><a href="#">Nuestros servicios</a></li>
              <li><a href="#">Politica de privacidad</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Cuenta</h4>
            <ul>
              <li><a href="#">Cuenta</a></li>
              <li><a href="#">Carrito</a></li>
              <li><a href="#">Compras</a></li>
            </ul>
          </div>
          <div class="pie-links">
            <h4>Tienda</h4>
            <ul>
              <li><a href="#">Inicio</a></li>
              <li><a href="#">Novedades</a></li>
              <li><a href="#">Categorias</a></li>
            </ul>
          </div>       
        </div>
      </div>
    </footer>
</body>
<script>
console.log(idUsuario);
</script>

</html>